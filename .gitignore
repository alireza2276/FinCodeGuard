# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
env/
ENV/

# ==============================
# Python packaging
# ==============================
build/
dist/
*.egg-info/
.eggs/

# ==============================
# Testing / coverage
# ==============================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ==============================
# Linters / type checking
# ==============================
.ruff_cache/
.mypy_cache/

# ==============================
# IDE / editors
# ==============================
.idea/
.vscode/
*.swp
*.swo

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example

*.pem
*.key

# ==============================
# Operating system files
# ==============================
.DS_Store
Thumbs.db

# ==============================
# Logs / temporary files
# ==============================
*.log
*.tmp
tmp/
temp/

# ==============================
# Local datasets
# ==============================
data/raw/*
data/processed/*

!data/raw/.gitkeep
!data/processed/.gitkeep

# ==============================
# Experiment outputs
# ==============================
experiments/raw_results/*
experiments/processed_results/*

!experiments/raw_results/.gitkeep
!experiments/processed_results/.gitkeep